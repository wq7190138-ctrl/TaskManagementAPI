name: dockercompose16313003277215868301
services:
  frontend:
    build:
      context: E:\.1AAACode\React\task-management-frontend-redux-ts
      dockerfile: Dockerfile
      args:
        VITE_API_URL: /api
    container_name: my-frontend
    depends_on:
      taskmanagementapi:
        condition: service_started
        required: true
    networks:
      my-dev-network: null
    ports:
      - mode: ingress
        target: 80
        published: "5173"
        protocol: tcp
  postgres_db:
    container_name: my-postgres-compose
    environment:
      POSTGRES_DB: mydb
      POSTGRES_PASSWORD: "123456"
      POSTGRES_USER: admin
    image: postgres:16-alpine
    networks:
      my-dev-network: null
    ports:
      - mode: ingress
        target: 5432
        published: "5432"
        protocol: tcp
    volumes:
      - type: volume
        source: postgres-data
        target: /var/lib/postgresql/data
        volume: {}
  rabbitmq:
    container_name: my-rabbitmq
    environment:
      RABBITMQ_DEFAULT_PASS: "123456"
      RABBITMQ_DEFAULT_USER: admin
    image: rabbitmq:3-management-alpine
    networks:
      my-dev-network: null
    ports:
      - mode: ingress
        target: 5672
        published: "5672"
        protocol: tcp
      - mode: ingress
        target: 15672
        published: "15672"
        protocol: tcp
  rabbitmqconsumer:
    build:
      context: E:\.1AAACode\C#\TaskManagementAPI\RabbitMQConsumer
      dockerfile: Dockerfile
    container_name: my-consumer
    depends_on:
      rabbitmq:
        condition: service_started
        required: true
    environment:
      DOTNET_ENVIRONMENT: Development
      RabbitMQ__Host: rabbitmq
      RabbitMQ__Password: "123456"
      RabbitMQ__Port: "5672"
      RabbitMQ__UserName: admin
    networks:
      my-dev-network: null
    volumes:
      - type: bind
        source: C:\Users\wq\AppData\Roaming/Microsoft/UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind: {}
      - type: bind
        source: C:\Users\wq\AppData\Roaming/Microsoft/UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind: {}
  redis_cache:
    container_name: my-redis-compose
    image: redis:7-alpine
    networks:
      my-dev-network: null
    ports:
      - mode: ingress
        target: 6379
        published: "6379"
        protocol: tcp
  taskmanagementapi:
    build:
      context: E:\.1AAACode\C#\TaskManagementAPI\TaskManagementAPI
      dockerfile: Dockerfile
    container_name: my-taskapi-compose
    depends_on:
      postgres_db:
        condition: service_started
        required: true
      rabbitmq:
        condition: service_started
        required: true
      redis_cache:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      ASPNETCORE_HTTPS_PORTS: "8081"
      ASPNETCORE_URLS: http://+:8080
      ConnectionStrings__DefaultConnection: Host=postgres_db;Port=5432;Database=mydb;Username=admin;Password=123456
      RabbitMQ__Host: rabbitmq
      RabbitMQ__Password: "123456"
      RabbitMQ__Port: "5672"
      RabbitMQ__UserName: admin
      Redis__ConnectionString: redis_cache:6379
    networks:
      my-dev-network: null
    ports:
      - mode: ingress
        target: 8080
        published: "5000"
        protocol: tcp
      - mode: ingress
        target: 8080
        protocol: tcp
      - mode: ingress
        target: 8081
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\wq\AppData\Roaming/Microsoft/UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind: {}
      - type: bind
        source: C:\Users\wq\AppData\Roaming/Microsoft/UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind: {}
      - type: bind
        source: C:\Users\wq\AppData\Roaming/ASP.NET/Https
        target: /home/app/.aspnet/https
        read_only: true
        bind: {}
      - type: bind
        source: C:\Users\wq\AppData\Roaming/ASP.NET/Https
        target: /root/.aspnet/https
        read_only: true
        bind: {}
networks:
  my-dev-network:
    name: dockercompose16313003277215868301_my-dev-network
    driver: bridge
volumes:
  postgres-data:
    name: dockercompose16313003277215868301_postgres-data